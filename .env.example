NODE_ENV=development
DATABASE_URL=postgresql://teletier:teletier@127.0.0.1:5432/teletier
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:3000
API_PORT=4000
PUBLIC_WEBHOOK_ORIGIN=https://replace-with-your-public-https-host.example
# Generate: openssl rand -hex 32. Required even in local mode.
TOKEN_ENCRYPTION_KEY=
TOKEN_KEY_VERSION=local-v1
# Explicit opt-ins. Both MUST be false in production.
DEV_LOGIN=false
TELEGRAM_FAKE=false
# Use only in an isolated staging database with Telegram test-environment bots.
TELEGRAM_ENV=production
DEV_OWNER_TELEGRAM_ID=100001
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Comma separated verified Telegram numeric IDs; no default platform operators.
OPERATOR_TELEGRAM_IDS=
INBOX_RETENTION_DAYS=30
