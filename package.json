{
  "name": "teletier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "next dev apps/web --hostname 127.0.0.1",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "db:generate": "prisma generate --schema packages/db/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/db/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "db:prepare-tests": "tsx scripts/prepare-tests.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run db:generate && npm run typecheck && next build apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run typecheck && npm run format:check",
    "start:api": "tsx apps/api/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "start:web": "next start apps/web --hostname 0.0.0.0"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/client": "6.19.0",
    "bullmq": "6.3.17",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.10",
    "prisma": "6.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
